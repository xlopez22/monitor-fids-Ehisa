# Copia este archivo como .env y completa la contraseña VNC de los equipos.
# VNC solo usa los primeros 8 caracteres de la contraseña.
VNC_PASSWORD=

# TLS para el tramo panel -> equipo. Requiere un stunnel/gateway TLS delante de cada VNC.
# VNC_TLS=1
# Ruta al certificado/CA (PEM) que firmó los certificados de los equipos.
# VNC_TLS_CA=C:\ruta\fids-ca.pem
# 1 = no validar el certificado (solo pruebas; pierde la protección contra MITM).
# VNC_TLS_INSECURE=0
# Solo si el certificado usa un nombre distinto a la IP del equipo.
# VNC_TLS_SERVERNAME=

# Login del panel. Genera estos tres valores con: npm run set-password
AUTH_PASSWORD_HASH=
SESSION_SECRET=
# Clave AES-256-GCM para las contraseñas VNC propias de cada equipo.
# No la cambies si ya hay contraseñas guardadas: el inventario quedaría ilegible.
DATA_ENCRYPTION_KEY=

# Hosts y orígenes permitidos (separados por coma).
# Por defecto se permiten 127.0.0.1 y localhost en PORT.
# APP_HOSTS=127.0.0.1:8080,localhost:8080
# APP_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
# COOKIE_SECURE=true si el panel va detrás de HTTPS
# TRUST_PROXY=1 si hay un reverse proxy delante

# Opcionales
# PORT=8080
# HOST=127.0.0.1
# VNC_PORT=5900
# Cada ronda abre UNA sesión VNC por equipo (estado + miniatura)
# Minutos sin cambios en la pantalla para mostrar "⏸ sin cambios" (solo informativo)
# FROZEN_MINUTES=30
# Qué tan distinta debe verse una pantalla de su referencia "normal" para avisar (0-255)
# BASELINE_DIFF=35
# Lo que teclea el botón "↻ NG-Client" en Ejecutar (Win+R) del equipo, en dos pasos
# NG_CLIENT_KILL=taskkill /f /im ng-client.exe
# NG_CLIENT_START=c:\dds\ng-client\ng-client.exe --fids-allow-invalid-cert
# ROUND_SECONDS=90
# CONCURRENCY=6
# INVENTORY_FILE=data/inventory.json
